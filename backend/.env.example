# Development values. Production: use deployment secret injection or a protected env file.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/heritage_planner
# Development minimum32, production minimum48 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
# disable only inside a private DB network; hosted DBs use verify-full.
DATABASE_SSL=disable
# Optional custom root CA PEM path; never disable certificate verification.
# DATABASE_SSL_CA_FILE=/run/secrets/postgres-ca.pem
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_TRANSACTION_IDLE_TIMEOUT_MS=30000
# Empty = direct connection. Configure only the actual trusted proxy CIDR(s).
TRUST_PROXY=
# Production always forbids self-registration as operator, regardless of this setting.
ALLOW_OPERATOR_REGISTRATION=false
# Default: production20 per15min, development500. Sensitive endpoints have separate buckets.
AUTH_RATE_LIMIT=20
GENERATION_RATE_LIMIT=30

# Heritage Guide: server-only Groq Free Plan. Never put the key in VITE variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set true ONLY after checking Billing shows Free Plan/no paid billing.
CHAT_FREE_PLAN_CONFIRMED=false
CHAT_RATE_LIMIT=6
CHAT_MAX_HISTORY=8
CHAT_MAX_OUTPUT_TOKENS=700
CHAT_DAILY_CALL_LIMIT=60
CHAT_TIMEOUT_MS=18000
CHAT_MOCK=false

# Display-only OSRM endpoint. Empty disables external road geometry; estimates remain.
MAP_ROUTING_URL=https://routing.openstreetmap.de/routed-car
