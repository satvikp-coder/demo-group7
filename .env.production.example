# Copy to .env.production (ignored). Never commit filled values.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# URL-encode password. Internal Compose network only; DB has no host port.
DATABASE_URL=postgresql://heritage_app:URL_ENCODED_APP_PASSWORD@postgres:5432/heritage_planner
DATABASE_ADMIN_URL=postgresql://heritage_owner:URL_ENCODED_ADMIN_PASSWORD@postgres:5432/heritage_planner
JWT_SECRET=
CORS_ORIGIN=https://YOUR_DOMAIN
HTTP_PORT=8080
PUBLIC_HOSTNAME=YOUR_DOMAIN
