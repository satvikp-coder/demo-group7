{
  "name": "heritage-tourism-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "translate": "tsx scripts/translate-content.ts",
    "test": "npm run test:unit && npm run test:planner",
    "lint": "tsc --noEmit",
    "test:unit": "tsx ../tests/dsa/trie.test.ts && tsx --test ../tests/frontend/catalog-images.test.ts",
    "test:planner": "tsx ../tests/frontend/planner.test.ts",
    "test:all": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "dom-to-image-more": "^3.10.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
