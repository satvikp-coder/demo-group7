# Development API. Copy to .env.local (ignored).
VITE_API_BASE_URL=http://localhost:5000/api
# Production build: set /api behind supplied nginx, or https://YOUR_API_HOST/api.
# Only VITE_* values enter the browser bundle. Never put secrets in them.
# Optional offline translation maintenance script only; never a frontend runtime key:
# GOOGLE_TRANSLATE_API_KEY=
